# Python / Environments
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/
.nox/
.tox/

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
.ipynb_checkpoints/
# Datasets & Large Files (DVC / Data)

# Raw / processed / external data are ignored.
data/raw/*
data/interim/*
data/processed/*
data/external/*

# Keep directories traversable by Git so DVC metadata can be tracked.
!data/raw/
!data/interim/
!data/processed/
!data/external/

# Keep placeholder files.
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# DVC metadata files must be tracked by Git.
!data/raw/*.dvc
!data/interim/*.dvc
!data/processed/*.dvc
!data/external/*.dvc

# DVC internal storage must NOT be tracked.
.dvc/cache
.dvc/local

# Model Artifacts & Heavy Experiments
models/*.bin
models/*.pt
models/*.onnx
models/*.pkl
models/*.safetensors
experiments/logs/
runs/
*.log

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Reports & Output Cache
reports/*.pdf
reports/*.html
